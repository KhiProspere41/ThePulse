# The Odds API — https://the-odds-api.com (free tier: 500 requests/month)
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# CollegeFootballData.com — free key at https://collegefootballdata.com/key.
# Only used by app/scripts/load_historical_cfb_data.py (the college football
# historical data pipeline), not by the live API server.
CFBD_API_KEY=your_cfbd_api_key_here

# Database
# Local/testing (SQLite, zero setup):
DATABASE_URL=sqlite:///./thepulse.db
# Production (Postgres):
# DATABASE_URL=postgresql://user:password@localhost:5432/thepulse

# Used to derive an NFL "week number" from each game's kickoff date, since
# the Odds API only returns commence_time, not a week index. Set this to the
# date/time (UTC, ISO 8601) of the season's first game.
# 2026 season opener: Seahawks vs. Patriots, Wed Sep 9, 8:20pm ET (the first
# Wednesday-opener season since 2012) = 2026-09-10T00:15:00 UTC.
NFL_SEASON_START=2026-09-10T00:15:00

# Same idea, but for college football's "week 1" — its calendar starts
# earlier than the NFL's and includes a "week 0" the weekend before.
# 2026: week 0 is Sat Aug 29, week 1 anchor is Thu Sep 3.
CFB_SEASON_START=2026-09-03T00:00:00

# --- Player props ------------------------------------------------------
# Pulled from The Odds API's per-event endpoint, which bills one credit per
# market returned PER EVENT. Six markets across a 16-game slate is ~96 credits
# — a fifth of the free tier's 500/month for a single refresh — so props are
# fetched on demand and cached, never polled by the scheduler.
PLAYER_PROP_MARKETS=player_pass_yds,player_pass_tds,player_rush_yds,player_reception_yds,player_receptions,player_anytime_td

# How long a game's cached props stay fresh before opening its page will spend
# credits refetching them.
PLAYER_PROPS_CACHE_HOURS=12

# --- Team futures ------------------------------------------------------
# The only NFL futures feed The Odds API publishes. Division winners and
# season win totals have no feed at all — app/simulate.py models those from
# the project's own Elo ratings instead.
NFL_FUTURES_SPORT_KEY=americanfootball_nfl_super_bowl_winner

# Futures barely move day to day and each refresh costs a credit, so this is
# daily rather than tied to the odds refresh interval.
FUTURES_REFRESH_INTERVAL_HOURS=24

# Once the monthly balance drops below this, discretionary fetches (props,
# futures) stop spending and serve cached prices instead, so the app degrades
# rather than going dark mid-month. Game lines are exempt.
ODDS_API_MIN_REMAINING=25

# --- Season simulation -------------------------------------------------
# Simulated seasons per run, and how long a result is cached in-process.
SIM_ITERATIONS=10000
SIM_CACHE_MINUTES=30

# How often the scheduler refreshes odds during the season (hours)
ODDS_REFRESH_INTERVAL_HOURS=24

# CORS — frontend dev server origin
FRONTEND_ORIGIN=http://localhost:5173
